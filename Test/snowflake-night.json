{
  "name": "Snowflake Night",
  "$schema": "vscode://schemas/color-theme",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background":             "#0D1117",
    "editor.foreground":             "#CDD9E5",
    "editor.lineHighlightBackground":"#161B22",
    "editor.selectionBackground":    "#2D3F5780",
    "editor.selectionHighlightBackground": "#2D3F5740",
    "editorLineNumber.foreground":   "#3D4F61",
    "editorLineNumber.activeForeground": "#8B9FC4",
    "editorCursor.foreground":       "#C4A0FF",
    "editorIndentGuide.background":  "#21262D",
    "editorIndentGuide.activeBackground": "#30363D",
    "editorBracketMatch.background": "#2D3F57",
    "editorBracketMatch.border":     "#7DCFFF60",
    "editorWidget.background":       "#161B22",
    "editorSuggestWidget.background":"#161B22",
    "editorSuggestWidget.border":    "#30363D",
    "editorSuggestWidget.selectedBackground": "#2D3F57",
    "statusBar.background":          "#161B22",
    "statusBar.foreground":          "#8B9FC4",
    "tab.activeBackground":          "#0D1117",
    "tab.activeForeground":          "#CDD9E5",
    "tab.inactiveBackground":        "#161B22",
    "tab.inactiveForeground":        "#4D6080",
    "sideBar.background":            "#0A0F14",
    "sideBar.foreground":            "#8B9FC4",
    "activityBar.background":        "#0A0F14",
    "activityBar.foreground":        "#CDD9E5",
    "titleBar.activeBackground":     "#0A0F14",
    "titleBar.activeForeground":     "#8B9FC4"
  },

  "tokenColors": [

    {
      "name": "Comments — muted lavender-gray",
      "scope": ["comment", "comment.line", "comment.block", "comment.block.documentation"],
      "settings": { "foreground": "#5B6EA8", "fontStyle": "italic" }
    },

    {
      "name": "Strings — soft mint",
      "scope": ["string", "string.quoted", "string.quoted.double", "string.quoted.triple", "string.quoted.raw"],
      "settings": { "foreground": "#A8F0CB" }
    },
    {
      "name": "Byte strings — slightly warmer",
      "scope": "string.quoted.byte",
      "settings": { "foreground": "#A8E4FF" }
    },
    {
      "name": "String escapes — soft peach",
      "scope": "constant.character.escape",
      "settings": { "foreground": "#FFD1A0" }
    },
    {
      "name": "String interpolation — gentle highlight",
      "scope": ["meta.interpolation", "variable.other.interpolated"],
      "settings": { "foreground": "#C4E8FF" }
    },

    {
      "name": "Numbers — soft peach-gold",
      "scope": ["constant.numeric", "constant.numeric.hex", "constant.numeric.binary", "constant.numeric.float", "constant.numeric.integer"],
      "settings": { "foreground": "#FFD1A0" }
    },

    {
      "name": "Boolean & null — soft violet",
      "scope": "constant.language",
      "settings": { "foreground": "#BD93F9", "fontStyle": "italic" }
    },

    {
      "name": "Control flow — lavender",
      "scope": "keyword.control",
      "settings": { "foreground": "#C4A0FF" }
    },

    {
      "name": "FROST ownership keywords — icy cyan",
      "scope": "keyword.other.frost",
      "settings": { "foreground": "#7DCFFF", "fontStyle": "italic" }
    },
    {
      "name": "FORGE linear types — soft rose",
      "scope": "keyword.other.forge",
      "settings": { "foreground": "#FFB3D1", "fontStyle": "italic" }
    },
    {
      "name": "CRYSTAL comptime — golden lilac",
      "scope": "keyword.other.crystal",
      "settings": { "foreground": "#E0AAFF" }
    },
    {
      "name": "GLACIER regions — cool teal",
      "scope": "keyword.other.glacier",
      "settings": { "foreground": "#67E8C8" }
    },
    {
      "name": "STORM processes — soft coral",
      "scope": "keyword.other.storm",
      "settings": { "foreground": "#FF9DC4" }
    },
    {
      "name": "PRISM determinism — periwinkle",
      "scope": "keyword.other.prism",
      "settings": { "foreground": "#9BAEFF" }
    },
    {
      "name": "MIRROR homoiconicity — dusty mauve",
      "scope": "keyword.other.mirror",
      "settings": { "foreground": "#DDA0DD" }
    },
    {
      "name": "ETHER effects — soft aqua",
      "scope": "keyword.other.ether",
      "settings": { "foreground": "#80E8E0" }
    },
    {
      "name": "AXIOM dependent types — pale gold",
      "scope": "keyword.other.axiom",
      "settings": { "foreground": "#FFE4A0" }
    },
    {
      "name": "VAULT capabilities — lavender pink",
      "scope": "keyword.other.vault",
      "settings": { "foreground": "#E0AAFF" }
    },
    {
      "name": "DEFER lazy evaluation — muted mint",
      "scope": "keyword.other.defer",
      "settings": { "foreground": "#88D9B8" }
    },
    {
      "name": "LOGIC unification — soft lilac",
      "scope": "keyword.other.logic",
      "settings": { "foreground": "#C8AAFF" }
    },
    {
      "name": "RANK polymorphism — cool sky",
      "scope": "keyword.other.rank",
      "settings": { "foreground": "#7DCFFF" }
    },
    {
      "name": "ARENA share-nothing — soft seafoam",
      "scope": "keyword.other.arena",
      "settings": { "foreground": "#67E8C8" }
    },

    {
      "name": "Function declaration keywords — pink",
      "scope": "keyword.declaration.function",
      "settings": { "foreground": "#FF9DC4" }
    },
    {
      "name": "Type declaration keywords — cyan",
      "scope": "keyword.declaration.type",
      "settings": { "foreground": "#7DCFFF" }
    },
    {
      "name": "Variable declaration keywords — lavender",
      "scope": "keyword.declaration.variable",
      "settings": { "foreground": "#C4A0FF" }
    },
    {
      "name": "String fiber declaration — mint",
      "scope": ["keyword.declaration.string", "keyword.declaration.string-kind"],
      "settings": { "foreground": "#A8F0CB" }
    },
    {
      "name": "Thread declaration — periwinkle",
      "scope": "keyword.declaration.thread",
      "settings": { "foreground": "#9BAEFF" }
    },
    {
      "name": "Mixin declaration — dusty mauve",
      "scope": "keyword.declaration.mixin",
      "settings": { "foreground": "#DDA0DD" }
    },

    {
      "name": "Import keywords — muted cyan",
      "scope": "keyword.other.import",
      "settings": { "foreground": "#67C8E8" }
    },
    {
      "name": "Modifier keywords — steel blue",
      "scope": "storage.modifier",
      "settings": { "foreground": "#8BBDDC" }
    },
    {
      "name": "Word operators (and, or, is, in, as) — lavender",
      "scope": "keyword.operator.word",
      "settings": { "foreground": "#C4A0FF" }
    },
    {
      "name": "Concurrency keywords — soft coral",
      "scope": "keyword.other.concurrency",
      "settings": { "foreground": "#FF9DC4" }
    },
    {
      "name": "Systems keywords — muted amber",
      "scope": "keyword.other.systems",
      "settings": { "foreground": "#C8A86A" }
    },
    {
      "name": "Mixin keywords — dusty mauve",
      "scope": "keyword.other.mixin",
      "settings": { "foreground": "#DDA0DD" }
    },

    {
      "name": "Function definition name — soft pink",
      "scope": "entity.name.function",
      "settings": { "foreground": "#FFB3D1", "fontStyle": "bold" }
    },
    {
      "name": "Function call — lighter pink",
      "scope": "entity.name.function.call",
      "settings": { "foreground": "#FF9DC4" }
    },
    {
      "name": "Type names (PascalCase) — cyan",
      "scope": "entity.name.type",
      "settings": { "foreground": "#7DCFFF" }
    },
    {
      "name": "Foreign language name in embed — teal",
      "scope": "entity.name.type.language",
      "settings": { "foreground": "#67E8C8", "fontStyle": "italic" }
    },

    {
      "name": "Built-in types — bright cyan",
      "scope": "support.type.builtin",
      "settings": { "foreground": "#7DCFFF" }
    },

    {
      "name": "Annotation — soft gold",
      "scope": ["entity.other.attribute-name", "meta.preprocessor"],
      "settings": { "foreground": "#FFD580" }
    },

    {
      "name": "Variables — soft foreground",
      "scope": "variable.other",
      "settings": { "foreground": "#CDD9E5" }
    },

    {
      "name": "Walrus operators := and ::= — lavender bold",
      "scope": "keyword.operator.assignment.walrus",
      "settings": { "foreground": "#C4A0FF", "fontStyle": "bold" }
    },
    {
      "name": "Fat arrow => — pink",
      "scope": "keyword.operator.arrow.fat",
      "settings": { "foreground": "#FF9DC4" }
    },
    {
      "name": "Thin arrow -> — steel blue",
      "scope": "keyword.operator.arrow.thin",
      "settings": { "foreground": "#8BBDDC" }
    },
    {
      "name": "Pipe |> — aqua",
      "scope": "keyword.operator.pipe",
      "settings": { "foreground": "#67E8C8" }
    },
    {
      "name": "Alternative <|> — lavender",
      "scope": "keyword.operator.alternative",
      "settings": { "foreground": "#C4A0FF" }
    },
    {
      "name": "Compose >> << — periwinkle",
      "scope": "keyword.operator.compose",
      "settings": { "foreground": "#9BAEFF" }
    },
    {
      "name": "String concat <> — mint",
      "scope": "keyword.operator.concat",
      "settings": { "foreground": "#A8F0CB" }
    },
    {
      "name": "Power ** — peach",
      "scope": "keyword.operator.power",
      "settings": { "foreground": "#FFD1A0" }
    },
    {
      "name": "Comparison operators — steel blue",
      "scope": "keyword.operator.comparison",
      "settings": { "foreground": "#8BBDDC" }
    },
    {
      "name": "Assignment = — lavender dim",
      "scope": "keyword.operator.assignment",
      "settings": { "foreground": "#A088D0" }
    },
    {
      "name": "Arithmetic — soft blue-gray",
      "scope": "keyword.operator.arithmetic",
      "settings": { "foreground": "#8BBDDC" }
    },
    {
      "name": "Optional operators ? ! — peach",
      "scope": "keyword.operator.optional",
      "settings": { "foreground": "#FFD1A0" }
    },
    {
      "name": "Range .. ... — lavender",
      "scope": "keyword.operator.range",
      "settings": { "foreground": "#C4A0FF" }
    },
    {
      "name": "Capability token ~ — violet",
      "scope": "keyword.operator.capability",
      "settings": { "foreground": "#BD93F9" }
    },
    {
      "name": "Null coalescing ?? — peach",
      "scope": "keyword.operator.null-coalescing",
      "settings": { "foreground": "#FFD1A0" }
    },
    {
      "name": "Unification =:= — lilac",
      "scope": "keyword.operator.unify",
      "settings": { "foreground": "#C8AAFF" }
    },

    {
      "name": "Punctuation braces — dim",
      "scope": "punctuation.section.braces",
      "settings": { "foreground": "#4D6080" }
    },
    {
      "name": "Punctuation brackets — dim",
      "scope": "punctuation.section.brackets",
      "settings": { "foreground": "#4D6080" }
    },
    {
      "name": "Punctuation parens — dim",
      "scope": "punctuation.section.parens",
      "settings": { "foreground": "#4D6080" }
    },
    {
      "name": "Punctuation comma, semicolon — dimmer",
      "scope": ["punctuation.separator.comma", "punctuation.terminator.semicolon"],
      "settings": { "foreground": "#3D4F61" }
    },
    {
      "name": "Colon — steel",
      "scope": "punctuation.separator.colon",
      "settings": { "foreground": "#5B7A9A" }
    },
    {
      "name": "Dot accessor — steel",
      "scope": "punctuation.accessor.dot",
      "settings": { "foreground": "#5B7A9A" }
    },
    {
      "name": "Pipe separator | — periwinkle dim",
      "scope": "punctuation.separator.pipe",
      "settings": { "foreground": "#6878A0" }
    },
    {
      "name": "Annotation @ — gold",
      "scope": "punctuation.definition.annotation",
      "settings": { "foreground": "#FFD580" }
    },

    {
      "name": "Embedded foreign code block — dimmed",
      "scope": ["meta.embedded.block", "meta.embedded.foreign", "meta.ext.block"],
      "settings": { "foreground": "#7B8B9A", "fontStyle": "italic" }
    },
    {
      "name": "Interpolation block — soft highlight",
      "scope": "meta.interpolation",
      "settings": { "foreground": "#C4E8FF" }
    }
  ]
}
