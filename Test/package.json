{
  "name": "tree-sitter-snowflake",
  "version": "1.0.0",
  "description": "Tree-sitter grammar for the Snowflake programming language",
  "main": "bindings/node",
  "keywords": ["parser", "tree-sitter", "snowflake"],
  "dependencies": {
    "nan": "^2.17.0"
  },
  "devDependencies": {
    "tree-sitter-cli": "^0.20.8"
  },
  "scripts": {
    "build":    "tree-sitter generate && node-gyp build",
    "generate": "tree-sitter generate",
    "test":     "tree-sitter test",
    "parse":    "tree-sitter parse"
  },
  "tree-sitter": [
    {
      "scope":       "source.snow",
      "file-types":  ["snow", "snx"],
      "highlights":  "queries/highlights.scm",
      "injections":  "queries/injections.scm",
      "locals":      "queries/locals.scm"
    }
  ]
}
