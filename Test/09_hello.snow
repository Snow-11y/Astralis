// ─────────────────────────────────────────────────────────────────────────────
// hello.snow — basic Snowflake syntax tour
// ─────────────────────────────────────────────────────────────────────────────

imp net.minecraft.client.Minecraft
imp net.minecraft.entity.player.EntityPlayer
imp java.util.List

// ── Variables — dynamic by default ───────────────────────────────────────────

name := "Snow"               // inferred: String
score := 100                  // inferred: Int
ratio := 3.14                 // inferred: Double
active := true                 // inferred: Bool

counter ::= 0                    // mutable, inferred: Int
counter += 1

// Explicit type hint — optional, never required
hp: Int := 200
tag: String := "player"

// Nullable — only POSSIBLE when declared with ?
maybe? := getPlayer()           // may be null
explicit: String? := null

// Safe access chain — never throws NPE
health := maybe?.health        // null if maybe is null
name2 := maybe?.gameProfile?.name?.toLowerCase()

// Force unwrap — explicit danger, readable
forced := maybe!.health


// ── Functions ─────────────────────────────────────────────────────────────────

fn greet(name) {
    log("Hello $name!")
}

// Type hints on params (optional)
fn add(a: Int, b: Int) -> Int {
    ret a + b
}

// Single-expression — no braces, no ret keyword
fn square(n) = n * n

fn clamp(val, lo, hi) = if val < lo { lo } else if val > hi { hi } else { val }

// Named parameter: call as greet(to: "Snow")
fn greet(to name) {
    log("Hi $name")
}

// Default value
fn connect(host, port = 25565, timeout = 5000) {
    log("Connecting to $host:$port (timeout: ${timeout}ms)")
}

// Varargs
fn sum(...nums) = nums.fold(0, (acc, n) => acc + n)

// First-class function
transform := fn(x) => x * 2
doubled := [1, 2, 3].map(transform)


// ── String interpolation ──────────────────────────────────────────────────────

player := "Snow"
level := 42
status := "alive"

log("Player: $player  Level: $level")
log("Status: ${if level > 10 { "experienced" } else { "newbie" }}")

report := """
    Player:  $player
    Level:   $level
    Status:  $status
    Double:  ${level * 2}
"""


// ── Collections ───────────────────────────────────────────────────────────────

items := [1, 2, 3, 4, 5]
unique := #{1, 2, 3, 2, 1}         // Set — no duplicates
config := {"host": "localhost", "port": 25565}

// Pipeline
result := items
    .filter(x => x % 2 == 0)
    .map(x => x * 10)
    .fold(0, (a, b) => a + b)

// Spread
extended := [...items, 6, 7, 8]
merged := {...config, "debug": true}

// Destructuring
let [first, second, ...rest] = items
let {host, port}             = config

// For loop
for item in items {
    log("Item: $item")
}

// For with index via range
for i in 0..items.size() {
    log("$i: ${items[i]}")
}

// Map destructuring
for (key, val) in config {
    log("$key = $val")
}


// ── Control flow ──────────────────────────────────────────────────────────────

// if is an expression
label := if score > 100 { "elite" } else if score > 50 { "mid" } else { "low" }

// when — exhaustive pattern matching
msg := when level {
    in 0..10   => "newbie"
    in 11..50  => "veteran"
    in 51..100 => "elite"
    else       => "unknown"
}

// when with type patterns
fn describe(obj) = when obj {
    is String s   => "string: $s"
    is Int n      => "number: $n"
    is List items => "list of ${items.size()} items"
    null          => "nothing"
    else          => "something: $obj"
}

// whl / loop / brk
x ::= 0
whl x < 10 {
    x += 1
}

loop {
    next := queue.poll()
    if next == null { brk }
    next.process()
}


// ── Error handling ────────────────────────────────────────────────────────────

// try is an expression
data := try {
    loadFile("config.json")
} cth IOException e {
    log("IO failed: ${e.message}")
    "{}"
} cth e {
    log("Unknown: $e")
    null
}

// Custom err type
err NetworkError(message: String, code: Int)
err ParseError(message: String, line: Int)

fn fetch(url) -> String {
    if url.isEmpty() {
        thr NetworkError("Empty URL", 400)
    }
    ret Http.get(url)
}


// ── Classes ───────────────────────────────────────────────────────────────────

cls Entity(id: Int, name: String) {
    health ::= 100
    maxHealth := 100
    dead ::= false
    prv _ticks ::= 0

    // Computed property
    val isAlive get() = health > 0
    val pct     get() = (health * 100) / maxHealth

    fn tick() {
        _ticks += 1
        if health <= 0 { die() }
    }

    fn hurt(amount: Int) {
        health -= clamp(amount, 0, health)
    }

    prv fn die() {
        dead = true
        log("$name died at tick $_ticks")
    }
}

// Instantiation — no "new" keyword
zombie := Entity(42, "Zombie")
zombie.hurt(30)
log("Alive: ${zombie.isAlive}  HP: ${zombie.pct}%")

// Inheritance
cls Player(id, name) : Entity(id, name) {
    xp ::= 0
    level ::= 1

    ovr fn tick() {
        super.tick()
        xp += 1
        if xp >= level * 100 {
            level += 1
            xp = 0
            log("$name levelled up to $level!")
        }
    }
}

// Data class — auto equals/hashCode/toString/copy
rec BlockPos(x: Int, y: Int, z: Int)

origin := BlockPos(0, 64, 0)
above := origin.copy(y: 65)
log("$origin → $above")


// ── Async / concurrent ────────────────────────────────────────────────────────

afn fetchChunk(pos: BlockPos) -> String {
    ret ChunkIO.load(pos)
}

afn loadWorld() {
    // Await a single future
    chunk := awt fetchChunk(BlockPos(0, 0, 0))

    // Parallel — all three run concurrently, wait for all
    let [c1, c2, c3] = awt par {
        fetchChunk(BlockPos(0,  0, 0))
        fetchChunk(BlockPos(16, 0, 0))
        fetchChunk(BlockPos(32, 0, 0))
    }
    log("Loaded: $c1  $c2  $c3")
}
